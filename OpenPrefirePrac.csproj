<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseCounterStrikeSharp>true</UseCounterStrikeSharp>

    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaxMind.GeoIP2" Version="6.0.0" />
    <PackageReference Include="MaxMind.Db" Version="5.1.0" />
  </ItemGroup>

  <!-- The practice profiles, translations and bot behaviour trees belong next to the dll, so a plain
       Release build/publish is deployable too (not only the package.sh zip). -->
  <ItemGroup>
    <None Include="maps\**\*;lang\**\*;resources\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="CounterStrikeSharp.targets" />
</Project>
